{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "NAIZO"
    ],
    "contact": {
        "homepage": "https://www.nightbeam.cloud"
    },
    "license": "${license}",
    "icon": "logo.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "tn.nightbeam.betterfarmingplus.BetterFarmingPlusModFabric"
        ],
        "client": [
            "tn.nightbeam.betterfarmingplus.BetterFarmingPlusModFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "jauml": "*"
    }
}
